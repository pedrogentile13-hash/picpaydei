rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para verificar se o usuário é dono do documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Dados do professor - isolados por usuário
    // Estrutura: users/{userId}/...
    match /users/{userId} {
      // Só o próprio usuário pode ler/escrever seus dados
      allow read, write: if isAuthenticated() && isOwner(userId);

      // Configurações do professor
      match /config/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // Alunos do professor
      match /students/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // VAs do professor
      match /vas/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // PBs do professor
      match /pbs/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // Histórico de alterações (audit log)
      match /audit/{document=**} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        // Não permite update ou delete do histórico
        allow update, delete: if false;
      }
    }

    // Bloqueia acesso a qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
